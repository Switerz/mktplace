# ============================================================
# Torre de Controle de Marketplaces GoBeautÃ© â€” .env.example
# Copie para .env e preencha com valores reais. NUNCA commite .env.
# ============================================================

# --- Banco de dados local (app prÃ³prio) ---
DATABASE_URL=postgresql://user:password@localhost:5432/mktplace_control
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/mktplace_control_test

# --- Data Mart (leitura â€” fonte de dados existente) ---
DATAMART_HOST=
DATAMART_PORT=5432
DATAMART_DB=
DATAMART_USER=
DATAMART_PASSWORD=
# Schemas disponÃ­veis: raw, api, gold

# --- Metabase ---
METABASE_URL=https://metabase.gobeaute.com.br
METABASE_API_KEY=

# --- TikTok Shop API (para ingestÃ£o direta futura) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# --- Mercado Livre API (para ingestÃ£o direta futura) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_SELLER_ID_BARBOURS=
ML_SELLER_ID_KOKESHI=
ML_SELLER_ID_LESCENT=

# --- Shopee (fase atual: exports manuais; fase futura: API oficial) ---
SHOPEE_DATA_PATH=./shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=

# --- App ---
APP_ENV=development  # development | staging | production
APP_SECRET_KEY=
API_PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# Em desenvolvimento aponta para a API local. Em PRODUCAO (Vercel) o valor e /torre-api
# (mesma origem, via rewrite); nesse caso TORRE_API_ORIGIN e obrigatorio no build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Logs ---
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | text

# --- Jobs / Sync ---
SYNC_INTERVAL_MINUTES=60
BACKFILL_DAYS_DEFAULT=90


# --- B2B / Revendedores (Torre B2B como fonte externa read-only) ---
# Ver docs/b2b_revenda_contrato.md. Data API do Supabase, chamada SO' pelo
# backend. A chave NUNCA vai para variavel NEXT_PUBLIC_* nem para o frontend.
# Autenticacao das rotas (Auth0 corporativo). Vazio = rota fechada (503).
API_AUTH_ISSUER=
API_AUTH_AUDIENCE=
B2B_REVENDA_REQUIRED_SCOPE=b2b_revenda:read
# authenticated (padrao) | public_readonly (temporario, sem token; ver docs)
B2B_REVENDA_ACCESS_MODE=authenticated
B2B_REVENDA_RATE_LIMIT_PER_MINUTE=60
B2B_REVENDA_RATE_LIMIT_GLOBAL_PER_MINUTE=600
B2B_REVENDA_ENABLED=false
B2B_REVENDA_SUPABASE_URL=
B2B_REVENDA_SUPABASE_KEY=
B2B_REVENDA_TIMEOUT_SECONDS=10
B2B_REVENDA_CACHE_TTL_SECONDS=1200
B2B_REVENDA_CANAIS_KPI=Mercado Livre,Shopee
# Web: ausente = desligada | fixture = dados ficticios | api = le a nossa API
NEXT_PUBLIC_B2B_REVENDA_MODE=

# --- Login Google (ver docs/AUTH_GOOGLE_RUNBOOK.md) ---
# Valores reais ficam so na Vercel/Render. NUNCA commitar.
# Vercel: client ID do OAuth do GoHunter (398963590019-....apps.googleusercontent.com).
# Vazio = login desligado (usuario dev@local).
AUTH_GOOGLE_ID=
# Vercel E Render, mesmo valor nos dois. >= 32 caracteres; NOVO, nao reaproveitar o do GoHunter.
# Gerar: openssl rand -base64 32
AUTH_SECRET=
# Vercel E Render: dominios de e-mail permitidos (csv). Padrao: gocase.com,gobeaute.com.br
ALLOWED_EMAIL_DOMAINS=gocase.com,gobeaute.com.br
# Render (API): off (padrao) | report (so registra auth_report negaria) | enforce (bloqueia com 401)
TORRE_AUTH_MODE=off
# Render (API): chave de servico, >= 32 caracteres. Gerar: openssl rand -base64 32
TORRE_SERVICE_KEY=
# Vercel (web): destino do rewrite /torre-api. Obrigatorio se NEXT_PUBLIC_API_URL for relativo.
TORRE_API_ORIGIN=
# Vercel (Oraculo MCP): mesmo valor de TORRE_SERVICE_KEY do Render.
MCP_BACKEND_SERVICE_KEY=
