# ============================================================
# Torre de Controle de Marketplaces GoBeautÃ© â€” .env.example
# Copie para .env e preencha com valores reais. NUNCA commite .env.
# ============================================================

# --- Banco de dados local (app prÃ³prio) ---
DATABASE_URL=postgresql://user:password@localhost:5432/mktplace_control
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/mktplace_control_test

# --- Data Mart (leitura â€” fonte de dados existente) ---
DATAMART_HOST=
DATAMART_PORT=5432
DATAMART_DB=
DATAMART_USER=
DATAMART_PASSWORD=
# Schemas disponÃ­veis: raw, api, gold

# --- Metabase ---
METABASE_URL=https://metabase.gobeaute.com.br
METABASE_API_KEY=

# --- TikTok Shop API (para ingestÃ£o direta futura) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# --- Mercado Livre API (para ingestÃ£o direta futura) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_SELLER_ID_BARBOURS=
ML_SELLER_ID_KOKESHI=
ML_SELLER_ID_LESCENT=

# --- Shopee (fase atual: exports manuais; fase futura: API oficial) ---
SHOPEE_DATA_PATH=./shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=

# --- App ---
APP_ENV=development  # development | staging | production
APP_SECRET_KEY=
API_PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Logs ---
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | text

# --- Jobs / Sync ---
SYNC_INTERVAL_MINUTES=60
BACKFILL_DAYS_DEFAULT=90


# --- B2B / Revendedores (Torre B2B como fonte externa read-only) ---
# Ver docs/b2b_revenda_contrato.md. Data API do Supabase, chamada SO' pelo
# backend. A chave NUNCA vai para variavel NEXT_PUBLIC_* nem para o frontend.
# Autenticacao das rotas (Auth0 corporativo). Vazio = rota fechada (503).
API_AUTH_ISSUER=
API_AUTH_AUDIENCE=
B2B_REVENDA_REQUIRED_SCOPE=b2b_revenda:read
B2B_REVENDA_ENABLED=false
B2B_REVENDA_SUPABASE_URL=
B2B_REVENDA_SUPABASE_KEY=
B2B_REVENDA_TIMEOUT_SECONDS=10
B2B_REVENDA_CACHE_TTL_SECONDS=1200
B2B_REVENDA_CANAIS_KPI=Mercado Livre,Shopee
# Web: ausente = desligada | fixture = dados ficticios | api = le a nossa API
NEXT_PUBLIC_B2B_REVENDA_MODE=
# Web, SO' servidor (BFF de login da aba B2B; ver docs/b2b_revenda_ativacao.md).
# Nenhuma delas e' NEXT_PUBLIC_: nao chegam ao navegador.
B2B_AUTH_ISSUER=
B2B_AUTH_AUDIENCE=
B2B_AUTH_CLIENT_ID=
B2B_AUTH_CLIENT_SECRET=
B2B_AUTH_SESSION_SECRET=
B2B_AUTH_APP_BASE_URL=
B2B_API_BASE_URL=
