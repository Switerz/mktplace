{
  "_metadata": { "major_version": 2 },
  "display_information": {
    "name": "Torre de Marketplaces",
    "description": "Alertas da Torre de Marketplaces no privado de quem acompanha a operação.",
    "background_color": "#1f2937"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": { "display_name": "Torre", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "im:read",
        "im:history",
        "users:read",
        "users:read.email",
        "app_mentions:read",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.im"] },
    "interactivity": { "is_enabled": false },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
